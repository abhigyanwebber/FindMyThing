# Copy to backend/.env for local development. Never commit real values.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
API_PUBLIC_ORIGIN=http://localhost:8000
CAMPUS_CONFIG_PATH=config/campus.json
LOCAL_BLOB_DIR=./.localblob
# Local SQL Server container (docker run ... -p 14333:1433). Local only: TrustServerCertificate=yes is rejected in production.
DATABASE_URL=Driver={ODBC Driver 18 for SQL Server};Server=localhost,14333;Database=findmything;UID=sa;PWD=<local-dev-password>;Encrypt=yes;TrustServerCertificate=yes
TEST_ADMIN_DATABASE_URL=Driver={ODBC Driver 18 for SQL Server};Server=localhost,14333;Database=master;UID=sa;PWD=<local-dev-password>;Encrypt=yes;TrustServerCertificate=yes
