# Copy to `.env.local` (untracked) for local development. Build-time values only: NEVER put secrets or credentials here.
# API base INCLUDING the /api prefix (contract section 15). Production: https://api.<owner-domain>/api
# (a custom hostname under the same registrable domain as the frontend, so the session cookie is same-site).
# In `npm run dev` the value defaults to the local API below when unset; production builds require it.
VITE_API_BASE_URL=http://localhost:8000/api
